#Configure Protocols
ENABLE WEB
ENABLE SECURESH
DISABLE TELNET
ENABLE XMLREPLY
ENABLE GUI_LOGIN_DETAIL
ENABLE ACTIVE_HEALTH_SYSTEM
ENABLE ENCLOSURE_ILO_FEDERATION_SUPPORT
SET SECURESH SERVER KEX DHG1 ENABLE
DISABLE FQDN_LINK_SUPPORT
SET SNMP_SYSNAME DEFAULT

#Configure Alertmail
SET ALERTMAIL SMTPSERVER 
DISABLE ALERTMAIL

#Configure Trusted Hosts
#REMOVE TRUSTED HOST ALL
DISABLE TRUSTED HOST

#Configure NTP
SET NTP PRIMARY {{ ntp1 }}
SET NTP SECONDARY {{ ntp2 }}
SET NTP POLL 720
ENABLE NTP

#Set SNMP Information
SET SNMP CONTACT "{{ snmp_contact }}"
SET SNMP LOCATION "{{ snmp_location }}"
SET SNMP COMMUNITY READ "{{ snmp_community }}"
SET SNMP COMMUNITY WRITE ""
SET SNMP VERSION ENABLE
ENABLE SNMP

#Set SNMPv3 Information
SET SNMP ENGINEID "MAKISSSNMP"

#Set Remote Syslog Information
SET REMOTE SYSLOG SERVER "{{ remote_syslog_server }}"
SET REMOTE SYSLOG PORT 514
DISABLE SYSLOG REMOTE

