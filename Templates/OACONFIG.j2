#Script Generated by Administrator

#Set Enclosure Time
SET TIMEZONE Mideast/Riyadh89

#Set Enclosure Information
SET ENCLOSURE ASSET TAG "{{ enc_name}}"
SET ENCLOSURE NAME "{{ enc_name}}"
SET RACK NAME "{{ rack_name}}"

SET POWER MODE REDUNDANT
SET POWER SAVINGS OFF
#Power limit must be within the range of 2700-16400 Watts AC
SET POWER LIMIT OFF
#Enclosure Dynamic Power Cap must be within the range of 2866-5228 Watts AC
#Derated Circuit Capacity must be within the range of 2866-5228 Watts AC
#Rated Circuit Capacity must be within the range of 2866-5228 Watts AC
SET ENCLOSURE POWER_CAP OFF
SET ENCLOSURE POWER_CAP_BAYS_TO_EXCLUDE None

#Set PowerDelay Information
SET INTERCONNECT POWERDELAY 1 0
SET INTERCONNECT POWERDELAY 2 0
